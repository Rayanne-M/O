 "scenes": [
  {
   "id": "s2_cache_cache",
   "zone": "place",
   "when": {
    "day": 1,
    "moment": "midi"
   },
   "title": "Le cache-cache",
   "who": "Margot, Basile, Élio",
   "line": "« Cache-cache. C'est toi qui cherches, t'es arrivé en dernier. » Basile : « Pas dans la forêt, hein. Ni près du puits. Et pas le droit de se cacher à l'intérieur ! »"
  },
  {
   "id": "s2_margot",
   "zone": "chene",
   "when": {
    "day": 1,
    "moment": "midi"
   },
   "title": "Margot en haut du chêne",
   "who": "Margot",
   "line": "Des glands tombent quand on passe dessous. « La reine des brigands se laisse attraper, c'est différent. »"
  },
  {
   "id": "s2_basile",
   "zone": "cachette_basile",
   "when": {
    "day": 1,
    "moment": "midi"
   },
   "title": "Basile dans le buisson",
   "who": "Basile, Ysol",
   "line": "Ses sabots dépassent du buisson. Ysol, à son rouet : « Je n’ai vu personne. » Basile : « C’est pas juste, elle m’a dénoncé avec les yeux ! »"
  },
  {
   "id": "s2_fausse_piste_basile",
   "zone": "devant_basile",
   "when": {
    "day": 1,
    "moment": "midi"
   },
   "title": "Fausse piste : chez Basile",
   "who": "La mère de Basile",
   "line": "Elle coud sur le pas de la porte, les petits frères partout : « Basile ? On joue pas dans ma maison. Dehors ! »"
  },
  {
   "id": "s2_aubin",
   "zone": "moulin_dehors",
   "when": {
    "day": 1,
    "moment": "midi"
   },
   "title": "Aubin chasse le héros",
   "who": "Aubin",
   "line": "« Dehors ! On joue pas devant mon moulin. »"
  },
  {
   "id": "s2_elio",
   "zone": "puits",
   "when": {
    "day": 1,
    "moment": "midi"
   },
   "title": "Élio sur la margelle",
   "who": "Élio",
   "line": "On le trouve en dernier, en suivant le lavoir. « Je me cachais pas. J'aime bien ici. C'est calme. Chez moi c'est pas calme. »"
  },
  {
   "id": "s3_legende",
   "zone": "puits",
   "when": {
    "day": 1,
    "moment": "fin d'après-midi"
   },
   "title": "La légende du puits",
   "who": "Basile, Margot, Élio",
   "line": "« Quand un enfant garde une rancune trop longtemps… elle remonte la boire. »"
  },
  {
   "id": "s7_balade",
   "zone": "devant_barbier",
   "when": {
    "day": 2,
    "moment": "matin"
   },
   "title": "La balade pendant que les grands parlent",
   "line": "On peut se promener dans le salon et dans la rue devant."
  },
  {
   "id": "s8_aubin",
   "zone": "devant_barbier",
   "when": {
    "day": 2,
    "moment": "fin de matinée"
   },
   "title": "Aubin et son rasoir",
   "who": "Aubin",
   "line": "« C'est toi, le copain du gamin. Tu lui diras de rentrer tôt. Ce soir, je lui rase la tête. »"
  },
  {
   "id": "s9_riviere",
   "zone": "riviere_baignade",
   "when": {
    "day": 2,
    "moment": "après-midi"
   },
   "title": "La baignade",
   "who": "Margot, Basile, les enfants",
   "line": "On joue à la balle dans l'eau. Margot : « Moi je sors souvent par ma fenêtre la nuit. Elle n'en sait rien. »"
  },
  {
   "id": "s9_elio_rive",
   "zone": "rive_elio",
   "when": {
    "day": 2,
    "moment": "après-midi"
   },
   "title": "Élio sur la rive",
   "who": "Élio",
   "line": "« J'ai pas envie qu'on voie mes bras. » « C'est elle qui m'a fait les tresses. C'est tout ce qu'il me reste d'elle. »"
  },
  {
   "id": "s10_tete_rasee",
   "zone": "place",
   "when": {
    "day": 3,
    "moment": "matin"
   },
   "title": "La tête rasée",
   "who": "Élio, Margot",
   "line": "« Il l'a fait hier soir. Il a jeté les tresses dans le poêle. J'ai juste sauvé ça. » Un ruban bleu, à moitié brûlé."
  },
  {
   "id": "s11_peur_basile",
   "zone": "lavoir",
   "when": {
    "day": 3,
    "moment": "après-midi"
   },
   "title": "La peur de Basile",
   "who": "Basile",
   "line": "« Il a de la rancune plein le ventre. La Rancunière va venir. Faut prévenir les autres. »"
  },
  {
   "id": "s12_a_demain",
   "zone": "place",
   "when": {
    "day": 3,
    "moment": "fin d'après-midi"
   },
   "title": "« À demain »",
   "who": "Élio",
   "line": "« Garde-le, toi. Chez moi, il le brûlerait. » Ses derniers mots vivants : « À demain. »"
  },
  {
